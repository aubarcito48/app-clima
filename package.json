{
  "name": "app-clima",
  "version": "0.0.0",
  "scripts": {
    "start": "vite",
    "test:env": "node --test scripts/test-api-config.mjs",
    "build": "npm run typecheck && vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --watch",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc --project e2e/tsconfig.json",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.react.json",
    "preview": "vite preview --host 127.0.0.1 --port 4200",
    "test:voice": "node scripts/test-voice.mjs"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "leaflet": "1.9.4",
    "rxjs": "~7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.19.2",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "sass": "^1.108.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "type": "module"
}
