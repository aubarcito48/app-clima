# Configuración PÚBLICA del frontend. Copiar como .env para personalizar localmente.
# Estos valores serán visibles en el navegador. Nunca colocar API keys aquí.
# Las claves de OpenWeather y Groq pertenecen exclusivamente al backend Django.
PUBLIC_API_BASE_URL_DEVELOPMENT=http://localhost:8000
PUBLIC_API_BASE_URL_PRODUCTION=https://api-clima.example.invalid
